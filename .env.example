# Optional overrides for the runnable foundation. Defaults work without a .env file.
# Frontend reads this root file through Vite's envDir. Restart Vite after changes.
# Every VITE_ variable is browser-visible; never put privileged keys in one.
VITE_API_BASE_URL=http://127.0.0.1:8000
ENVIRONMENT=development
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Step 3: uncomment all four after creating a project and applying the migration.
# Use the same URL and publishable key for both services. Never use a secret key.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Step 4: server-only PostgreSQL connections and a separate service signing key.
# Use dedicated least-privilege login roles; see docs/TELEMETRY.md.
# DATABASE_URL=postgresql://event_server:password@localhost:5432/sherlock_logs
# COLLECTOR_DATABASE_URL=postgresql://audit_reader:password@localhost:5432/sherlock_logs
# INGESTION_SIGNING_KEY=replace-with-at-least-32-random-bytes
EVENT_RETENTION_DAYS=30

# FUTURE milestones only: the following are not read or validated yet.
# MODEL_ARTIFACT_PATH=artifacts/isolation_forest/model.joblib
# WORKER_POLL_SECONDS=2
