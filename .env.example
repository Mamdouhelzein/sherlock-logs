# VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=replace-with-server-only-secret
# SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
# SUPABASE_JWT_AUDIENCE=authenticated
# DATABASE_URL=postgresql://user:password@localhost:5432/sherlock_logs
# ACCOUNT_IDENTIFIER_HMAC_KEY=replace-with-random-server-only-secret
# MODEL_ARTIFACT_PATH=artifacts/isolation_forest/model.joblib
# WORKER_POLL_SECONDS=2
