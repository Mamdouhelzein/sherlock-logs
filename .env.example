# Optional overrides for the runnable foundation. Defaults work without a .env file.
# Frontend reads this root file through Vite's envDir. Restart Vite after changes.
# Every VITE_ variable is browser-visible; never put privileged keys in one.
VITE_API_BASE_URL=http://127.0.0.1:8000
ENVIRONMENT=development
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Step 3: uncomment all four after creating a project and applying the migration.
# Use the same URL and publishable key for both services. Never use a secret key.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Step 4: server-only PostgreSQL connections and a separate service signing key.
# Use dedicated least-privilege login roles; see docs/TELEMETRY.md.
# DATABASE_URL=postgresql://event_server:password@localhost:5432/sherlock_logs
# COLLECTOR_DATABASE_URL=postgresql://audit_reader:password@localhost:5432/sherlock_logs
# INGESTION_SIGNING_KEY=replace-with-at-least-32-random-bytes
EVENT_RETENTION_DAYS=30

# Step 7: separate shadow-scoring worker; no inference runs in the API process.
# Public deployment configuration only; readiness remains an administrator check.
DETECTION_ENABLED=false
# Apply the inference migration and grant sherlock_worker only to a new server login.
# WORKER_DATABASE_URL=postgresql://scoring_worker:password@localhost:5432/sherlock_logs
# MODEL_ARTIFACT_DIR=artifacts/models/iforest-v1
# WORKER_MODEL_VERSION=replace-with-the-complete-artifact-bundle-fingerprint
# WORKER_TRUST_LOCAL_ARTIFACT=false
WORKER_POLL_SECONDS=2
WORKER_LEASE_SECONDS=60
WORKER_HISTORY_LIMIT=10000

# Automatic collection: separate process, existing restricted audit + event logins.
COLLECTION_INTERVAL_SECONDS=30
COLLECTION_MAX_PAGES=1000
# Physical 30-day cleanup requires separate owner approval and Supabase Cron setup.

# Optional provider-confirmed invalid-password attempts. Scoped token only:
# one project, Logs Read; no database/Auth configuration/billing permissions.
# Keep server-only. Never use VITE_ or a full-account legacy access token.
# AUTH_LOGS_TOKEN=sbp_fc_replace_with_scoped_logs_read_token
# AUTH_LOGS_PROJECT_REF=yourtwentyletterrefxx
AUTH_LOGS_MAX_PAGES=10
