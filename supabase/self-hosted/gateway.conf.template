# Only the public publishable key enters this configuration. Signing stays in Auth/REST.
map_hash_bucket_size 128;
map $http_apikey $valid_api_key {
    default 0;
    "${LOCAL_PUBLIC_KEY}" 1;
}
map $http_authorization $session_authorization {
    default $http_authorization;
    "Bearer ${LOCAL_PUBLIC_KEY}" "";
}
map $http_origin $allowed_origin {
    default "";
    "http://127.0.0.1:5180" "http://127.0.0.1:5180";
}
server {
    listen 8080;
    server_tokens off;
    access_log off;
    # Nginx request-error logs can include the confirmation token's query string.
    error_log /dev/null;
    client_max_body_size 16k;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Access-Control-Allow-Origin $allowed_origin always;
    add_header Vary Origin always;
    add_header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS" always;
    add_header Access-Control-Allow-Headers "apikey, authorization, content-type, x-client-info, x-supabase-api-version, prefer, accept-profile, content-profile" always;
    if ($request_method = OPTIONS) { return 204; }

    location = /healthz { return 200 "ok"; }
    # Auth management and metrics have no public route.
    location ~ ^/auth/v1/(admin|metrics)(/|$) { return 404; }
    location /auth/v1/ {
        # Confirmation links have no apikey header and are verified by Auth itself.
        # All other Auth requests must identify this local API configuration.
        set $auth_access $valid_api_key;
        if ($uri = /auth/v1/verify) { set $auth_access 1; }
        if ($auth_access = 0) { return 401; }
        proxy_pass http://auth:9999/;
        proxy_set_header Authorization $session_authorization;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Proto http;
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Headers;
        proxy_hide_header Access-Control-Allow-Methods;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
    }
    location /rest/v1/ {
        if ($valid_api_key = 0) { return 401; }
        proxy_pass http://rest:3000/;
        proxy_set_header Authorization $session_authorization;
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Headers;
        proxy_hide_header Access-Control-Allow-Methods;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
    }
    location / { return 404; }
}
